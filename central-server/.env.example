# Central Server Configuration

# Server port
PORT=3001

# CORS allowed origins (comma-separated)
# For development: CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# For production: CORS_ALLOWED_ORIGINS=https://your-app.example.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate limiting configuration
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_IP_MAX=30
LOGIN_RATE_LIMIT_USERNAME_MAX=10
MFA_RATE_LIMIT_WINDOW_MINUTES=15
MFA_RATE_LIMIT_MAX=5

# Require HTTPS (recommended: keep enabled)
# Enforced automatically when NODE_ENV=production; set REQUIRE_HTTPS=0 only for
# trusted internal networks without TLS. The server should be behind a reverse
# proxy that sets the X-Forwarded-Proto header.
REQUIRE_HTTPS=1

# Production mode enables HTTPS enforcement and a strict CORS default.
# NODE_ENV=production

# Reverse proxy configuration (required when behind a load balancer or reverse proxy)
# TRUSTED_PROXIES: comma-separated list of trusted proxy IP addresses or CIDR ranges
# TRUST_PROXY: set to "true" or "1" to trust the X-Forwarded-* headers from proxies
# Example: TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8 TRUST_PROXY=true
# Without these settings, HTTPS requests through a proxy will be rejected.
# TRUSTED_PROXIES=127.0.0.1
# TRUST_PROXY=false

# Disable startup check (set to 1 to disable)
# CENTRAL_DISABLE_STARTUP_CHECK=1
