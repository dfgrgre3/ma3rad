{
  "schemaVersion": 1,
  "profileVersion": 1,
  "id": "workshop",
  "name": {
    "ar": "ورشة أو خدمات تشغيل",
    "en": "Workshop or field services"
  },
  "description": {
    "ar": "خدمات ومخزون اختياري",
    "en": "Services with optional inventory"
  },
  "category": "services",
  "configuration": {
    "businessModel": "mixed",
    "trackInventory": true,
    "units": [
      "SERVICE",
      "PIECE"
    ],
    "customUnits": [],
    "productAttributes": [
      "نوع الخدمة",
      "الموديل"
    ]
  },
  "modules": {
    "enabledByDefault": [
      "sales",
      "inventory",
      "customers",
      "finance",
      "operations",
      "reports",
      "documents",
      "projects",
      "hr",
      "manufacturing"
    ],
    "optional": [
      "purchasing",
      "approvals"
    ]
  },
  "support": {
    "profileDefaults": "implemented",
    "productAttributes": "stored-as-text-attributes",
    "industrySpecificWorkflows": "not-implemented",
    "industrySpecificReports": "not-implemented",
    "industrySpecificDocumentTemplates": "not-implemented",
    "typedCustomFieldStorage": "not-implemented",
    "workOrdersAndTechnicianScheduling": "not-implemented"
  },
  "printTemplates": [
    {
      "id": "sales_invoice_workshop",
      "documentType": "sales_invoice",
      "templateId": "compact",
      "label": {
        "ar": "فاتورة ورشة",
        "en": "Sales invoice"
      }
    }
  ],
  "dashboard": [
    {
      "id": "today_sales",
      "label": {
        "ar": "مبيعات اليوم",
        "en": "today_sales"
      },
      "source": "sales",
      "format": "currency"
    },
    {
      "id": "month_sales",
      "label": {
        "ar": "مبيعات الشهر",
        "en": "month_sales"
      },
      "source": "sales",
      "format": "currency"
    },
    {
      "id": "gross_profit",
      "label": {
        "ar": "مجمل الربح",
        "en": "gross_profit"
      },
      "source": "sales",
      "format": "currency"
    },
    {
      "id": "avg_order",
      "label": {
        "ar": "متوسط الفاتورة",
        "en": "avg_order"
      },
      "source": "sales",
      "format": "currency"
    },
    {
      "id": "low_stock",
      "label": {
        "ar": "نواقص المخزون",
        "en": "low_stock"
      },
      "source": "inventory",
      "format": "number"
    },
    {
      "id": "receivables",
      "label": {
        "ar": "ديون العملاء",
        "en": "receivables"
      },
      "source": "finance",
      "format": "currency"
    }
  ],
  "reports": [
    {
      "id": "r0",
      "reportId": "product-sales",
      "category": "sales",
      "label": {
        "ar": "product-sales",
        "en": "product-sales"
      }
    },
    {
      "id": "r1",
      "reportId": "slow-moving",
      "category": "sales",
      "label": {
        "ar": "slow-moving",
        "en": "slow-moving"
      }
    },
    {
      "id": "r2",
      "reportId": "sales-analysis",
      "category": "sales",
      "label": {
        "ar": "sales-analysis",
        "en": "sales-analysis"
      }
    },
    {
      "id": "r3",
      "reportId": "ar-aging",
      "category": "sales",
      "label": {
        "ar": "ar-aging",
        "en": "ar-aging"
      }
    },
    {
      "id": "r4",
      "reportId": "shift-closing",
      "category": "sales",
      "label": {
        "ar": "shift-closing",
        "en": "shift-closing"
      }
    }
  ],
  "features": [
    "عربات صيانة",
    "ضمان",
    "فروع متعددة"
  ],
  "pricingRules": {
    "tiers": [
      {
        "id": "wholesale",
        "name": "سعر الجملة",
        "factor": 0.9
      },
      {
        "id": "min_price",
        "name": "أقل سعر مسموح",
        "factor": 0.85
      },
      {
        "id": "distributor",
        "name": "سعر الموزع",
        "factor": 0.8
      },
      {
        "id": "vip",
        "name": "سعر كبار العملاء",
        "factor": 0.9
      }
    ]
  },
  "permissions": {
    "roles": [
      {
        "role": "SERVICE_TECH",
        "name": "فني خدمة",
        "permissions": [
          "orders.view",
          "orders.create",
          "orders.update",
          "customers.view",
          "customers.create",
          "products.view",
          "sales.view",
          "sales.create"
        ]
      },
      {
        "role": "WAREHOUSE_KEEPER",
        "name": "أمين مخزن",
        "permissions": [
          "inventory.view",
          "inventory.transfer",
          "inventory.count",
          "inventory.adjust",
          "inventory.warehouse_stock.view",
          "inventory.showroom_stock.view",
          "products.view",
          "products.stock.view",
          "products.barcodes.print",
          "warehouses.view"
        ]
      },
      {
        "role": "CASHIER",
        "name": "كاشير",
        "permissions": [
          "sales.pos.view",
          "sales.pos.hold",
          "sales.pos.resume",
          "sales.pos.print",
          "sales.pos.discount",
          "sales.pos.void",
          "sales.create",
          "sales.invoice.print",
          "customers.view",
          "customers.create",
          "cashier.view",
          "cashier.shift",
          "cashier.shift.open",
          "cashier.shift.close",
          "cashier.expense"
        ]
      },
      {
        "role": "SUPERVISOR",
        "name": "مشرف",
        "permissions": [
          "sales.view",
          "sales.create",
          "sales.update",
          "sales.approve",
          "sales.discount",
          "sales.refund",
          "returns.view",
          "returns.create",
          "orders.view",
          "orders.approve",
          "orders.update",
          "customers.view",
          "customers.create",
          "customers.update",
          "products.view",
          "inventory.view",
          "reports.view",
          "reports.sales.view",
          "finance.view",
          "finance.receivables.view"
        ]
      }
    ]
  }
}
