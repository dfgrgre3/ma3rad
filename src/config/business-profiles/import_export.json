      "source": "sales",
      "format": "currency"
    },
    {
      "id": "today_purchases",
      "label": {
        "ar": "مشتريات اليوم",
        "en": "today_purchases"
      },
      "source": "sales",
      "format": "currency"
    },
    {
      "id": "inventory_value",
      "label": {
        "ar": "قيمة المخزون",
        "en": "inventory_value"
      },
      "source": "inventory",
      "format": "currency"
