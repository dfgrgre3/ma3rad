{
  "schemaVersion": 1,
  "profileVersion": 1,
  "id": "import_export",
  "name": {
    "ar": "الاستيراد والتصدير",
    "en": "Import and export"
  },
  "description": {
    "ar": "مشتريات ومبيعات ومخزون وإعدادات عملات",
    "en": "Purchasing, sales, inventory and currency settings"
  },
  "category": "trade",
  "configuration": {
    "businessModel": "mixed",
    "trackInventory": true,
    "units": [
      "PIECE",
      "KG",
      "TON",
      "LITER",
      "BOX",
      "PACK"
    ],
    "customUnits": [],
    "productAttributes": [
      "بلد المنشأ",
      "رمز التصنيف",
      "نوع التعبئة"
    ]
  },
  "modules": {
    "enabledByDefault": [
      "sales",
      "inventory",
      "customers",
      "purchasing",
      "finance",
      "reports",
      "approvals",
      "documents",
      "projects",
      "hr",
      "manufacturing"
    ],
    "optional": [
      "operations"
    ]
  },
  "support": {
    "profileDefaults": "implemented",
    "industrySpecificWorkflows": "partially-implemented",
    "industrySpecificReports": "not-implemented",
    "industrySpecificDocumentTemplates": "partially-implemented",
    "typedCustomFieldStorage": "implemented-for-profile-declared-fields",
    "customsAndLandedCostWorkflows": "partially-implemented",
    "multiCurrencyTradeProcessing": "not-implemented"
  },
  "printTemplates": [
    {
      "id": "sales_invoice_import_export",
      "documentType": "sales_invoice",
      "templateId": "detailed",
      "label": {
        "ar": "فاتورة تصدير تفصيلية",
        "en": "Sales invoice"
      }
    }
  ],
  "dashboard": [
    {
      "id": "month_sales",
      "label": {
        "ar": "مبيعات الشهر",
        "en": "month_sales"
