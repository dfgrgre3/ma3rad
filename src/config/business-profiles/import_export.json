    {
      "id": "r2",
      "reportId": "inventory-balances",
      "category": "sales",
      "label": {
        "ar": "inventory-balances",
        "en": "inventory-balances"
      }
    },
    {
      "id": "r3",
      "reportId": "financial-position",
      "category": "sales",
      "label": {
        "ar": "financial-position",
        "en": "financial-position"
