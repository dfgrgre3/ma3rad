      "source": "finance",
      "format": "currency"
    },
    {
      "id": "receivables",
      "label": {
        "ar": "الذمم المدينة",
        "en": "receivables"
      },
      "source": "finance",
      "format": "currency"
    },
    {
      "id": "avg_order",
      "label": {
        "ar": "متوسط الفاتورة",
        "en": "avg_order"
      },
      "source": "sales",
      "format": "currency"
    },
    {
      "id": "total_debt",
      "label": {
        "ar": "الديون",
        "en": "total_debt"
      },
      "source": "finance",
      "format": "currency"
    }
