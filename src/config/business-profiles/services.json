      "label": {
        "ar": "ar-aging",
        "en": "ar-aging"
      }
    },
    {
      "id": "r1",
      "reportId": "payment-behavior",
      "category": "credit",
      "label": {
        "ar": "payment-behavior",
        "en": "payment-behavior"
      }
    },
    {
      "id": "r2",
      "reportId": "sales-analysis",
      "category": "credit",
      "label": {
        "ar": "sales-analysis",
        "en": "sales-analysis"
      }
    },
    {
      "id": "r3",
      "reportId": "branch-performance",
      "category": "credit",
      "label": {
        "ar": "branch-performance",
        "en": "branch-performance"
      }
    }
