          "sales.refund",
          "returns.view",
          "returns.create",
          "orders.view",
          "orders.approve",
          "orders.update",
          "customers.view",
          "customers.create",
          "customers.update",
          "products.view",
          "inventory.view",
          "reports.view",
          "reports.sales.view",
          "finance.view",
          "finance.receivables.view"
