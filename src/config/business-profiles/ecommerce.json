      "format": "currency"
    },
    {
      "id": "month_sales",
      "label": {
        "ar": "مبيعات الشهر",
        "en": "month_sales"
      },
      "source": "sales",
      "format": "currency"
    },
    {
      "id": "gross_profit",
      "label": {
        "ar": "مجمل الربح",
        "en": "gross_profit"
      },
      "source": "sales",
      "format": "currency"
    },
    {
      "id": "avg_order",
      "label": {
        "ar": "متوسط الفاتورة",
        "en": "avg_order"
      },
      "source": "sales",
      "format": "currency"
    },
    {
      "id": "low_stock",
      "label": {
        "ar": "نواقص المخزون",
        "en": "low_stock"
