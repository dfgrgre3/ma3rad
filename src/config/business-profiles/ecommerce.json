        "en": "basket"
      }
    },
    {
      "id": "r1",
      "reportId": "customer-churn",
      "category": "sales",
      "label": {
        "ar": "customer-churn",
        "en": "customer-churn"
      }
    },
    {
      "id": "r2",
      "reportId": "sales-analysis",
      "category": "sales",
      "label": {
        "ar": "sales-analysis",
        "en": "sales-analysis"
      }
    },
    {
      "id": "r3",
      "reportId": "product-profitability",
      "category": "sales",
      "label": {
        "ar": "product-profitability",
        "en": "product-profitability"
      }
    },
    {
      "id": "r4",
      "reportId": "ar-aging",
      "category": "sales",
      "label": {
        "ar": "ar-aging",
        "en": "ar-aging"
