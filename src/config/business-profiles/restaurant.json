  "permissions": {
    "roles": [
      {
        "role": "WAITER",
        "name": "نادل",
        "permissions": [
          "restaurant.view",
          "restaurant.orders.create",
          "sales.pos.view",
          "sales.pos.hold",
          "sales.pos.resume",
          "sales.pos.print",
          "customers.view"
        ]
      },
      {
        "role": "KITCHEN_STAFF",
        "name": "عامل مطبخ",
        "permissions": [
          "restaurant.view",
          "restaurant.orders.create"
        ]
      },
      {
        "role": "CASHIER",
        "name": "كاشير",
        "permissions": [
          "sales.pos.view",
          "sales.pos.hold",
          "sales.pos.resume",
          "sales.pos.print",
          "sales.pos.discount",
          "sales.pos.void",
