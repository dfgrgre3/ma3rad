          "cashier.shift",
          "cashier.shift.open",
          "cashier.shift.close",
          "cashier.expense"
        ]
      },
      {
        "role": "SUPERVISOR",
        "name": "مشرف",
        "permissions": [
          "sales.view",
          "sales.create",
          "sales.update",
          "sales.approve",
          "sales.discount",
          "sales.refund",
          "returns.view",
          "returns.create",
          "orders.view",
          "orders.approve",
          "orders.update",
          "customers.view",
          "customers.create",
          "customers.update",
          "products.view",
          "inventory.view",
          "reports.view",
          "reports.sales.view",
          "finance.view",
          "finance.receivables.view"
        ]
