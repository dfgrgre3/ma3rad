{
  "schemaVersion": 1,
  "profileVersion": 1,
  "id": "logistics",
  "name": {
    "ar": "الخدمات اللوجستية والنقل",
    "en": "Logistics and transportation"
  },
  "description": {
    "ar": "خدمات تشغيل وتوصيل وقوى عاملة",
    "en": "Service operations, deliveries and workforce"
  },
  "category": "services",
  "configuration": {
    "businessModel": "services",
    "trackInventory": false,
    "units": [
      "SERVICE",
      "METER"
    ],
    "customUnits": [],
    "productAttributes": [
      "نوع الخدمة",
      "نوع الشحنة",
      "منطقة التغطية"
    ]
  },
  "modules": {
    "enabledByDefault": [
      "sales",
      "customers",
      "finance",
      "operations",
      "reports",
      "approvals",
      "documents",
      "projects",
      "hr"
    ],
    "optional": [
      "inventory",
      "purchasing",
      "manufacturing"
    ]
  },
  "support": {
    "profileDefaults": "implemented",
    "deliveryModule": "available",
    "industrySpecificWorkflows": "partially-implemented",
    "industrySpecificReports": "not-implemented",
    "industrySpecificDocumentTemplates": "partially-implemented",
    "typedCustomFieldStorage": "implemented-for-profile-declared-fields",
    "routeAndFleetOptimization": "not-implemented"
  },
  "printTemplates": [
    {
      "id": "sales_invoice_logistics",
      "documentType": "sales_invoice",
      "templateId": "detailed",
      "label": {
        "ar": "بوليصة شحن تفصيلية",
        "en": "Sales invoice"
      }
    }
  ],
  "dashboard": [
    {
      "id": "month_sales",
      "label": {
        "ar": "مبيعات الشهر",
        "en": "month_sales"
      },
      "source": "sales",
      "format": "currency"
    },
    {
      "id": "today_purchases",
      "label": {
        "ar": "مشتريات اليوم",
        "en": "today_purchases"
      },
      "source": "purchases",
      "format": "currency"
    },
    {
      "id": "inventory_value",
      "label": {
        "ar": "قيمة المخزون",
        "en": "inventory_value"
      },
      "source": "inventory",
      "format": "currency"
    },
    {
      "id": "low_stock",
      "label": {
        "ar": "نواقص المخزون",
        "en": "low_stock"
      },
      "source": "inventory",
      "format": "number"
    }
  ],
  "reports": [
    {
      "id": "r0",
      "reportId": "daily-movements",
      "category": "operations",
      "label": {
        "ar": "daily-movements",
        "en": "daily-movements"
      }
    },
    {
      "id": "r1",
      "reportId": "operations-log",
      "category": "operations",
      "label": {
        "ar": "operations-log",
        "en": "operations-log"
      }
    },
    {
      "id": "r2",
      "reportId": "inventory-balances",
      "category": "operations",
      "label": {
        "ar": "inventory-balances",
        "en": "inventory-balances"
      }
    },
    {
      "id": "r3",
      "reportId": "branch-performance",
      "category": "operations",
      "label": {
        "ar": "branch-performance",
        "en": "branch-performance"
      }
    }
  ],
  "features": [
    "تتبع شحنات",
    "سائقون",
    "مركبات"
  ],
  "pricingRules": {
    "tiers": [
      {
        "id": "wholesale",
        "name": "سعر الجملة",
        "factor": 0.88
      },
      {
        "id": "min_price",
        "name": "أقل سعر مسموح",
        "factor": 0.82
      },
      {
        "id": "distributor",
        "name": "سعر الموزع",
        "factor": 0.75
      },
      {
        "id": "vip",
        "name": "سعر كبار العملاء",
        "factor": 0.88
      }
    ]
  },
  "permissions": {
    "roles": [
      {
        "role": "WAREHOUSE_KEEPER",
        "name": "أمين مخزن",
        "permissions": [
          "inventory.view",
          "inventory.transfer",
          "inventory.count",
          "inventory.adjust",
          "inventory.warehouse_stock.view",
          "inventory.showroom_stock.view",
          "products.view",
          "products.stock.view",
          "products.barcodes.print",
          "warehouses.view"
        ]
      },
      {
        "role": "PURCHASER",
        "name": "مسؤول مشتريات",
        "permissions": [
          "purchases.view",
          "purchases.create",
          "purchases.orders.view",
          "purchases.orders.create",
          "purchases.requests.view",
          "purchases.requests.create",
          "suppliers.view",
          "suppliers.create",
          "suppliers.update"
        ]
      },
      {
        "role": "DELIVERY_DRIVER",
        "name": "مندوب توصيل",
        "permissions": [
          "deliveries.view",
          "deliveries.create",
          "deliveries.update",
          "operations.fleet.view",
          "customers.view",
          "orders.view"
        ]
      },
      {
        "role": "SALES_REP",
        "name": "مندوب مبيعات",
        "permissions": [
          "sales.view",
          "sales.create",
          "sales.update",
          "sales.invoice.print",
          "orders.view",
          "orders.create",
          "orders.update",
          "customers.view",
          "customers.create",
          "customers.update",
          "crm.leads.view",
          "crm.leads.create",
          "crm.activities.view",
          "crm.activities.create",
          "quotations.view",
          "quotations.create"
        ]
      },
      {
        "role": "SUPERVISOR",
        "name": "مشرف",
        "permissions": [
          "sales.view",
          "sales.create",
          "sales.update",
          "sales.approve",
          "sales.discount",
          "sales.refund",
          "returns.view",
          "returns.create",
          "orders.view",
          "orders.approve",
          "orders.update",
          "customers.view",
          "customers.create",
          "customers.update",
          "products.view",
          "inventory.view",
          "reports.view",
          "reports.sales.view",
          "finance.view",
          "finance.receivables.view"
        ]
      }
    ]
  }
}
