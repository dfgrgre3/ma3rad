# CeramiSys ERP environment (optional)
# Vite dev server URL consumed by Electron in dev mode
VITE_DEV_SERVER_URL=http://localhost:5173

# Approved central API origin used by Electron's outbound network guard.
# The renderer's configured central URL must use this same HTTPS origin.
CENTRAL_API_URL=https://your-central-api.example.com

# Electron data directory override (optional)
# CERAMISYS_USER_DATA_DIR=C:\path\to\data
