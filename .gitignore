# Dependencies
node_modules/
# Build output
dist/
build/*
!build/icon.ico
!build/installer.nsh
/release/
*.tsbuildinfo

# Electron runtime data (created via app.setPath('userData', .../.electron-data))
.electron-data/

# Environment / secrets
.env
.env.*
!.env.example
*.pem
*.key

# Logs & temporary output
*.log
*.err
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local backups & patches
*.bak
*.bak.*
*.orig
*.tmp
*.swp

# Database / application data
*.db
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal

# Local scratch / one-off scripts
test-domain.js
apply_invoice_pagination.py

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Test & coverage
coverage/
.nyc_output/
*.lcov
test-results/
playwright-report/
blob-report/

# OS files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.AppleDouble/
.LSOverride

# Editor / IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.sublime-workspace
*.sublime-project

# Claude Code local settings
.claude/settings.local.json
.codex/

# Windows runtime-generated spellcheck dictionaries
Microsoft/

# UI audit (regenerable artifacts; run `npm run ui-audit:scan` and `npx playwright test e2e/ui-audit.spec.ts`)
docs/ui-audit/manifest.json
docs/ui-audit/smoke-report.json
