# One branch server in a two-branch, WireGuard-connected deployment.
# Create separate .env files on both servers using sync-server-deployment.md.
# Copy this file to .env, replace every placeholder, and never commit .env.

# PostgreSQL credentials used only inside the private Docker Compose network.
POSTGRES_USER=ceramisys
POSTGRES_PASSWORD=replace-with-a-unique-database-password
POSTGRES_DB=ceramisys

# Static addresses assigned to this server. Never bind either value to a public
# interface address. The host firewall must allow the LAN and WireGuard peers.
SYNC_LAN_PUBLISH_ADDRESS=192.168.10.10
SYNC_WIREGUARD_PUBLISH_ADDRESS=10.77.0.1

# This server is branch-1. Issue a different random token per desktop. Exactly
# one designated head-office device across both branches has policy authority.
# The peer-branch-2 token is issued BY branch-1 TO branch-2; branch-2 uses it
# when connecting back to this server.
CERAMISYS_SYNC_CLIENTS='[{"token":"replace-with-random-device-branch-1-token-at-least-32-bytes","tenantId":"company-1","branchId":"branch-1","deviceId":"device-1","canManageSyncPolicies":true,"canReadAllBranches":true},{"token":"replace-with-random-branch-1-to-branch-2-peer-token-at-least-32-bytes","tenantId":"company-1","branchId":"branch-1","deviceId":"peer-branch-2","canServePeerSync":true,"canReplicateBranches":["branch-2"]}]'

# This token is issued BY branch-2 TO branch-1 and must match branch-2's
# peer-branch-1 credential. The peer URL resolves to branch-2's WireGuard IP.
CERAMISYS_SYNC_PEERS='[{"peerId":"branch-2","url":"https://branch-2.wg.example:47821","token":"replace-with-random-branch-2-to-branch-1-peer-token-at-least-32-bytes","tenantId":"company-1","branchId":"branch-2","localDeviceId":"peer-branch-2"}]'
