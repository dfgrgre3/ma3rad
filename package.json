{
  "name": "ceramisys-erp",
  "version": "1.0.0",
  "description": "Desktop Ceramic & Finishing Materials Showroom Management ERP System",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:start": "set ELECTRON_RUN_AS_NODE=&& electron . --disable-gpu --in-process-gpu",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build",
    "electron:pack": "npm run build && electron-builder --dir",
    "electron:dist": "npm run build && electron-builder --win nsis",
    "test": "node --import ./test/register-hook.mjs --test --test-force-exit --test-concurrency=1 test/financials.test.ts test/integration.test.ts test/receivables.test.ts test/services.test.ts test/permissions.test.ts test/sales.test.ts test/escpos.test.ts test/dynamic-data.test.ts",
    "electron:dist:mac": "npm run build && electron-builder --mac",
    "electron:dist:linux": "npm run build && electron-builder --linux"
  },
  "build": {
    "appId": "com.ceramisys.erp",
    "productName": "CeramiSys ERP",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CeramiSys ERP"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.business"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office"
    },
    "dmg": {
      "title": "CeramiSys ERP"
    }
  },
  "keywords": [
    "ceramics",
    "pos",
    "erp",
    "inventory",
    "desktop",
    "electron",
    "sqlite"
  ],
  "author": "Antigravity Engineering",
  "license": "Commercial",
  "dependencies": {
    "@fontsource/cairo": "^5.3.0",
    "@types/react-router-dom": "^5.3.3",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "recharts": "^2.15.1",
    "sql.js": "^1.12.0",
    "tailwind-merge": "^3.0.1",
    "uuid": "^11.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/sql.js": "^1.4.9",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "crypto-browserify": "^3.12.1",
    "electron": "^34.2.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
